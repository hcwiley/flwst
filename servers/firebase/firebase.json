{
  "functions": [
    {
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "cd ../../.. && pnpm --filter @flwst/types build",
        "echo go into resource directory: \"$RESOURCE_DIR\"",
        "cp -r ../../types \"$RESOURCE_DIR\"/types",
        "cd \"$RESOURCE_DIR\" && npm install",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "postdeploy": ["rm -rf \"$RESOURCE_DIR\"/types"],
      "source": "functions"
    }
  ],
  "hosting": {
    "public": "hosting/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  }
}
