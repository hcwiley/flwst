{
  "name": "flwst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first flwst with Llama3 backend",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "keytar",
      "node-llama-cpp"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.base.json",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "download": "tsx scripts/download-models.ts",
    "dev:mac": "pnpm --filter=macos-electron dev",
    "dev:reasoning": "pnpm --filter=@flwst/reasoning dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@types/node": "22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv": "16.4.5",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-promise": "7.1.0",
    "husky": "9.1.6",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "turbo": "^2.6.1",
    "typescript": "5.6.3"
  }
}
