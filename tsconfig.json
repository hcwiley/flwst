{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@commands/*": [".cursor/commands/*"],
      "@notion.ts": ["config/notion.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "apps", "libs", "types", "servers"],
  "references": [
    { "path": "./types" },
    { "path": "./libs/core" },
    { "path": "./libs/ui" },
    { "path": "./libs/state" },
    { "path": "./libs/integrations" },
    { "path": "./apps/electron" },
    { "path": "./apps/mobile" },
    { "path": "./servers/firebase" }
  ]
}
