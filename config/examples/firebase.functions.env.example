# Firebase Functions Environment Variables
# These are set in Firebase Console under Functions > Configuration
# DO NOT commit actual values to git

# Gemini API Key (from Google Cloud Console)
GEMINI_API_KEY=your-gemini-api-key-here

# FlowState API Key (generate a secure random string)
FLOWSTATE_API_KEY=your-secure-api-key-here

# Optional: Model configuration
GEMINI_MODEL=gemini-pro

# Optional: Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
