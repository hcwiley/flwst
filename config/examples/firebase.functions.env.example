# Firebase Functions Environment Variables
# Set in Firebase Console under Functions > Configuration, or via deploy --set-env-vars
# DO NOT commit actual values to git

# Vertex AI mode (no API key; uses IAM / service account)
# Prerequisites: Blaze plan, Vertex AI API enabled, roles/aiplatform.user on function SA
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Optional: FlowState API key for future auth
# FLOWSTATE_API_KEY=your-secure-api-key-here

# Optional: Rate limiting
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
